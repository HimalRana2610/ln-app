<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
         Allow plain http:// during development only.

         Android blocks cleartext traffic by default for any app targeting
         API 28 or later, so http://192.168.1.x:8000 is refused even when the
         server is perfectly reachable. Production talks to an https:// backend
         and needs no exemption, so this lives in the debug manifest and is
         absent from release builds - the release APK stays cleartext-blocked.
    -->
    <application android:usesCleartextTraffic="true" />
</manifest>
